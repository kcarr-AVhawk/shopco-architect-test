# Dependencies — never commit these, they're regenerated from package.json
node_modules/

# Environment files — secrets stay out of git
.env
.env.local
.env.*.local

# Per-developer Claude Code state — not shared with the team
.claude/settings.local.json

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (none yet, but reserving the space)
dist/
build/
coverage/
